{
  "schemaVersion": 1,
  "id": "taczclient",
  "version": "${version}",
  "name": "TACZ Client Renderer",
  "description": "Client-only TACZ resource pack renderer for vanilla items.",
  "authors": [
    "TACZ Client Renderer contributors"
  ],
  "license": "GPL-3.0-only",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.tacz.client.TaczClient"
    ]
  },
  "mixins": [
    {
      "config": "taczclient.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  },
  "contact": {
    "homepage": "https://github.com/DanielFQZ/TACZ-Client-Renderer",
    "sources": "https://github.com/DanielFQZ/TACZ-Client-Renderer",
    "issues": "https://github.com/DanielFQZ/TACZ-Client-Renderer/issues"
  }
}
